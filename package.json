{
  "name": "overreach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --import jiti/register scripts/dev-api.ts",
    "dev:real": "VARLOCK_TELEMETRY_DISABLED=1 varlock run -- node --import jiti/register scripts/dev-api.ts --real",
    "build": "tsc && vite build",
    "build:preview": "VITE_PREVIEW=1 vite build --outDir dist-preview && node scripts/inline-preview.mjs",
    "typecheck": "tsc",
    "test": "node --import jiti/register --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:env": "VARLOCK_TELEMETRY_DISABLED=1 varlock audit -i node_modules -i dist -i dist-preview -i .netlify",
    "screens": "node scripts/screens.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@garmin/fitsdk": "21.217.0",
    "@netlify/blobs": "11.1.2",
    "date-fns": "4.1.0",
    "fflate": "0.8.3",
    "idb-keyval": "6.2.6",
    "lucide-react": "1.51.0",
    "motion": "12.43.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router": "7.18.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.0.1",
    "autoprefixer": "10.4.27",
    "jiti": "2.7.0",
    "playwright": "1.64.1",
    "postcss": "8.5.23",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "varlock": "1.23.0",
    "vite": "8.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
