# Overreach's settings, as a list varlock checks (varlock.dev). Safe to commit:
# no values live here. They live in two places, never in git:
#   - the deployed site: Netlify's environment variables, Production only
#   - this Mac: .env.local (gitignored), as varlock("local:…") refs only this Mac can decrypt
# Only `npm run dev:real` reads them here; the app in the browser never sees them.
# `npm run check:env` (and CI) fails if the code uses a variable that isn't listed here.
#
# @defaultSensitive=false @defaultRequired=false
# @auditIgnoreKeys(PROD, NETLIFY_BLOBS_CONTEXT)
# ---

# Garmin Personal API key, from connect.garmin.com/app/settings/personalApiToken.
# It expires after 30 days to a year. Only the server functions read it.
# @sensitive @required
GARMIN_PERSONAL_API_KEY=

# The phrase the app sends with every request; type the same one into Settings.
# Locally it falls back to "dev". On Netlify make it long and random.
# @sensitive
OVERREACH_PASSPHRASE=

# How many days back a local run against your real account reads, so trying it
# doesn't fetch two years twice. Leave it unset on Netlify, which reads two years.
# @type=number(min=14, max=730)
OVERREACH_HISTORY_DAYS=90

# Set to 1 by `npm run build:preview` for the one-file preview: memory router, no service worker.
VITE_PREVIEW=
